  "ui_patterns": {
    "layout": "Top horizontal nav (Sales | Orders | To Invoice | Products | Reporting | Configuration). Form pages have: breadcrumb + header buttons (top-left), smart-button row (top-right), then a centred white card with Name/scope checkboxes/tab strip and a two-column tabbed body. Chatter docks at bottom of form.",
    "color_scheme": {
      "primary": "purple-burgundy header buttons (e.g. 'Inventory at Date')",
      "accent_links": "teal/cyan for inline links and tab focus underline",
      "status_chips": "soft tinted backgrounds (Drinks=light grey, Furnitures=light grey, 15%=light grey)",
      "attribute_value_chips": "background colour matches the named colour (Black=red-ish demo, White=green demo, Pink=light pink)"
    },
    "navigation": {
      "tab_strip": "General Information | Attributes & Variants | Sales | Purchase | Inventory | Accounting | eBay",
      "smart_buttons": "Extra Prices, Documents, Go to Website, In/Out, Variants (after attributes saved), More dropdown",
      "breadcrumb": "Products / <name> [/ <subview>]",
      "pagination": "1/1 with prev/next chevrons top-right"
    },
    "tooltips": "Field labels carry a small '?' superscript that shows a help bubble on hover.",
    "view_toggles_on_lists": "list / kanban / graph icons top-right, plus search bar with active filter chips."
  },
  "cross_module_features": [
    "Chatter (Send message / Log note / WhatsApp / Activities) appears at bottom of all major detail forms",
    "Smart-button row contextual to the current record (counts e.g. Variants: 4)",
    "Multi-language indicator (EN) per textual field",
    "Save / discard cloud + revert icons appear in the breadcrumb area when the record is dirty",
    "Multi-company scoping via company_id on records"
  ]
}
